{
  "name": "backend-solvro-licytownik",
  "version": "1.0.0",
  "description": "Discord bot for Solvro licitation auctions",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "build": "tsup src/index.ts --format esm",
    "start": "node --env-file=.env dist/index.js",
    "deploy-commands": "tsx --env-file=.env src/utils/deploy-commands.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:generate:pg": "drizzle-kit generate --config=drizzle.pg.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:migrate:pg": "drizzle-kit migrate --config=drizzle.pg.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "discord.js": "^14.26.2",
    "dotenv": "^17.4.1",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/dotenv": "^8.2.3",
    "@types/node": "^25.6.0",
    "drizzle-kit": "^0.31.10",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
